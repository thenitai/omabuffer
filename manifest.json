{
  "schemaVersion": 1,
  "id": "thenitai.omabuffer",
  "name": "Buffer composer",
  "version": "0.1.0",
  "author": "thenitai",
  "license": "MIT",
  "description": "Post to Buffer from anywhere — queue or publish text posts to any connected channel via a global shortcut",
  "kinds": ["overlay", "bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "overlay": "Buffer.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Buffer composer",
    "description": "Open the Buffer composer",
    "category": "Social",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
